# Copy this file to ".env" and fill in your own values.
# The real .env is ignored by git so your credentials are never pushed.

PORT=3000
NODE_ENV=development

# Your MongoDB Atlas connection string.
# Atlas -> Database -> Connect -> Drivers.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sniperlab?retryWrites=true&w=majority
